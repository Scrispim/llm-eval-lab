# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# Modelos a comparar, separados por virgula. Descubra os disponiveis com: npm run models
# A lista de modelos gratuitos muda com frequencia: um modelo daqui pode virar 404 a qualquer momento.
# Sempre confira com `npm run models` antes de rodar o benchmark.
MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free

# Modelo "juiz" (LLM-as-judge). Use um modelo MAIS FORTE que os avaliados.
JUDGE_MODEL=

# --- Langfuse Cloud (https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Avaliacao ---
REPEATS=3          # execucoes por modelo x cenario (LLM nao e deterministica)
MAX_STEPS=15       # limite de chamadas ao modelo por investigacao (8 nao basta: o agente gasta
                   # varios passos so descobrindo datasources/metricas antes de investigar)
MAX_CONCURRENCY=1  # modelos gratuitos tem rate limit; mantenha baixo
