{
  "name": "llm-eval-lab",
  "version": "0.1.0",
  "description": "Benchmark de LLMs (OpenRouter) em investigações de observabilidade, com Langfuse para acurácia e latência",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "mcp:sim": "tsx src/mcp-incident-sim/server.ts",
    "eval": "tsx src/harness/run-eval.ts",
    "seed": "tsx src/harness/seed-dataset.ts",
    "models": "tsx src/harness/list-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "dotenv": "^18.0.3",
    "openai": "^7.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@langfuse/core": "^5.11.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
